{
  "mcpServers": {
    "sonarqube": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--init",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_ORG",
        "sonarsource/sonarqube-mcp:1.22.0.3040"
      ],
      "env": {
        "SONARQUBE_TOKEN": "${SONARQUBE_TOKEN:-}",
        "SONARQUBE_ORG": "${SONARQUBE_ORG:-}"
      }
    }
  }
}