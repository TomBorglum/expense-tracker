#!/usr/bin/env bash
#
# Auto-format staged Python files with Ruff, then re-stage them so the commit
# lands formatted in a single shot. Uses the pixi-managed Ruff (see pixi.toml),
# so the version matches CI/local exactly.
#
# Enable once per clone:
#   git config core.hooksPath .githooks
#
# Behavior:
#   - ruff check --fix applies safe fixes (import sorting, unused imports, ...).
#     It runs with --exit-zero, so unfixable lint findings never block a commit;
#     they still show as editor squiggles. Flip to a lint gate by dropping
#     --exit-zero if you later want commits blocked on lint errors.
#   - ruff format applies layout formatting.
#
# Caveat: if a file is only partially staged (git add -p), this stages the whole
# formatted file, including the previously unstaged hunks.
set -euo pipefail

# Staged, still-present Python files (added/copied/modified), NUL-delimited.
mapfile -d '' -t files < <(
  git diff --cached --name-only --diff-filter=ACM -z -- '*.py' '*.pyi'
)

if [ ${#files[@]} -eq 0 ]; then
  exit 0
fi

pixi run ruff check --fix --exit-zero --force-exclude -- "${files[@]}"
pixi run ruff format --force-exclude -- "${files[@]}"

git add -- "${files[@]}"
