# Rendered to /etc/nginx/conf.d/default.conf at container start by the base image's own
# 20-envsubst-on-templates.sh, which strips the .template suffix - so this REPLACES the
# stock default.conf rather than sitting beside it, and nothing of that file survives.
#
# ${API_BASE_URL} is the only substitution. Every other $name below is an nginx variable
# that has to reach nginx intact, and NGINX_ENVSUBST_FILTER in the Dockerfile is what holds
# envsubst to that one name.

# Cache-Control is computed here and set once at server level, add_header in a nested block
# REPLACING the inherited set instead of adding to it. Keeping every header on one
# directive is what puts the security headers below on every response, /assets/ included.
#
# The status is half the key. The year-long `immutable` lifetime belongs to a response that
# carries the asset, so a 404 on /assets/ during a deployment keeps the default below and
# stays retryable.
map $status $expense_tracker_served {
    default              "err";
    ~^(200|204|206|304)$ "ok";
}

# $uri is what try_files has already resolved, so a client-side route that fell back to
# the shell is matched here as /index.html and gets no-store. /assets/ is what vite
# content-hashes, and so what this map caches.
map "$expense_tracker_served$uri" $expense_tracker_cache_control {
    default      "no-store";
    ~^ok/assets/ "public, max-age=31536000, immutable";
}

server {
    # 8080, a port this base's nginx binds as 101, where a privileged one is out of reach.
    # The IPv6 line is written out by hand: the base's own
    # 10-listen-on-ipv6-by-default.sh compares default.conf against the checksum of the
    # PACKAGED one and bails when they differ, which in the unprivileged image they do, and
    # it runs before the envsubst script above replaces that file wholesale.
    #
    # default_server is what routes every request to this block. nginx makes the FIRST
    # server on an address:port the default and conf.d is included by glob, so stating it
    # puts the catch-all below on this declaration rather than on sort order, and a second
    # block claiming it makes nginx refuse to start. Only one block per address may carry
    # it, which is why both lines do - v4 and v6 are separate claims.
    listen 8080 default_server;
    listen [::]:8080 default_server;

    # `_` is an invalid hostname, used by convention to say that name-based virtual hosting
    # is not in use; default_server above is what routes every request here. The Host a
    # deployment presents is its own business - an ingress, a load balancer, or a browser
    # on 127.0.0.1:8080 all reach this one server.
    server_name _;

    # A document root of our own rather than the base's /usr/share/nginx/html, so the
    # served set is exactly what vite built. That directory arrives carrying a stock
    # 50x.html - a page that names nginx, where server_tokens off below does not - and no
    # error_page here points at it.
    root /srv/expense-tracker;

    # Keeps the version out of the Server header and off the built-in error pages.
    server_tokens off;

    # nginx.conf ships `#gzip  on;`, so compression is off unless a server asks for it.
    # Worth asking for: the one application chunk is 330 kB raw against 105 kB gzipped.
    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript image/svg+xml;

    # One header set for every response, the 404s below included - `always` is what
    # extends them past 2xx and 3xx. The CSP is derived from what the built bundle
    # actually loads, which is narrower than a default-deny policy usually gets to be:
    #
    #   script-src 'self'          one module script, and no inline script anywhere
    #   style-src 'unsafe-inline'  React renders inline `style` ATTRIBUTES (the date
    #                              picker, and the width hints in the tables), and an
    #                              attribute is governed by style-src-attr, which falls
    #                              back to style-src. style-src-elem keeps the tighter
    #                              rule on the stylesheet itself wherever a browser
    #                              implements it; Firefox ignores the directive.
    #   img-src data:              daisyUI inlines its checkbox and select glyphs as
    #                              url("data:image/svg+xml,...") inside the stylesheet.
    #   connect-src                the one API origin this container was given.
    #
    # No font-src: the type scale is system fonts and the bundle declares no @font-face.
    # frame-ancestors repeats X-Frame-Options for the browsers that honour only one, the
    # same pair create_app() sets on the API's own responses.
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; img-src 'self' data:; connect-src ${API_BASE_URL}; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Cache-Control $expense_tracker_cache_control always;

    # Hashed assets resolve or 404, stopping short of the SPA fallback below, so a missing
    # chunk reaches the module loader as the 404 it is.
    location /assets/ {
        try_files $uri =404;
    }

    # The SPA fallback, and the only location that falls back. / and /totals are
    # client-side routes with no file behind them, so anything that is not a real file is
    # answered with the shell and routed in the browser.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
