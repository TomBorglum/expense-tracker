{
  "name": "expense-tracker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "image": "docker buildx bake --allow=fs.read=.. dev",
    "lint": "eslint . --max-warnings 0",
    "lint-fix": "eslint . --fix",
    "test": "vitest run --coverage",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@daypicker/react": "10.0.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "daisyui": "5.7.50",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/language-server": "0.16.0",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.28",
    "@vtsls/language-server": "0.3.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "msw": "2.15.0",
    "prettier": "3.9.10",
    "tailwind-csstree": "0.4.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.11"
  }
}
