{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "isolatedModules": true,
    "skipLibCheck": true
  },
  // eslint.config.ts belongs to the Node-side tooling, not the browser app. Listing
  // it here gets it type-checked by `pnpm run typecheck` and gives typescript-eslint's
  // project service a real project for it, so no allowDefaultProject escape hatch is
  // needed to lint the lint config.
  "include": ["vite.config.ts", "eslint.config.ts"]
}
