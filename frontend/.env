# Origin of the REST API. src/api/expenses.ts resolves every request path against it,
# so this is the only place the frontend records where the backend lives.
#
# Committed, and in bare .env rather than .env.development, because vite loads this
# file in every mode -- including vitest's "test" mode, where the value is what MSW
# binds its handlers to. A .env.development would leave the suite with no base URL.
#
# Override locally in .env.local (gitignored) to point at a backend on another port.
VITE_API_BASE_URL=http://127.0.0.1:8000
