# Prettier runs from this directory (the "format" script in package.json passes "."),
# so only paths that can appear under frontend/ need listing. Everything at the repo
# root - pixi.lock, coverage/, .zed/, .claude/, .mcp.json, the release-please files,
# the workflow YAML - is out of prettier's reach by construction.

# Generated or vendored
node_modules/
pnpm-lock.yaml
dist/
# Written by the router plugin, which formats with prettier's own defaults
# rather than .prettierrc.json - so it lands at printWidth 80 and could never
# pass the check at 88. Excluding it is what the generator's header asks for.
src/routeTree.gen.ts

# Hand-formatted prose we do not want reflowed
*.md
