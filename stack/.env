# What the deployed stack reads. The single source of every name below, loaded by direnv
# through `dotenv_if_exists stack/.env` in .envrc - the same mechanism backend/.env goes
# through - and read a second time by compose itself, which auto-loads the .env beside the
# compose file it is given. Both routes read this file, so the two agree by construction.
#
# Committed, and holding development values only. Nothing here is a credential: the stack
# publishes no secret and the database on its network takes trust auth.
#
# EVERY variable stack/compose.yaml interpolates is declared here, the two host
# directories the loaders mount included, because release.yml loads the .env beside a
# compose file and no other: a name declared anywhere else is unset when that workflow
# renders this stack. A variable is still named in one file only - backend/.env no longer
# carries EXPENSE_DATA_DIR, and `poe load-expenses` reads it from here through direnv.

# What `docker compose -f stack/compose.yaml up` runs: the three images `poe image` and
# `pnpm run image` build locally, under the tag those bake files give them. release.yml
# overrides both when it publishes, with <namespace>/<repository> and the release tag,
# and the shell environment outranks this file, so its values win without editing it.
IMAGE_PREFIX=expense-tracker
IMAGE_VERSION=dev

# The origin the BROWSER calls, not a name on the compose network. It must be the host
# port the backend service publishes, so moving the API off 8000 means editing both.
API_BASE_URL=http://localhost:8000

# The two directories the profiled loaders bind-mount, read-only, and the one pair of
# values here that names a place on the host rather than a port or a tag. Both must be
# readable by uid 65532, and `create_host_path: false` in the compose file turns a missing
# one into a container that does not start rather than an empty mount.
#
# The rates live in THIS repository, so the path below is relative and resolves against
# the directory of the compose file compose was given - this one - which makes the stack
# provable from a checkout alone. The month files do not: real spending is confidential
# and this repository is public, so that one is absolute and points at the separate
# private repository. $HOME is expanded by direnv and by compose alike, which is why it is
# safe here where $PWD is not: direnv expands $PWD as THIS FILE'S directory and compose
# expands it as the invoking shell's, so one line would mean two different paths.
#
# A deployment holding no checkout sets BOTH absolutely in a .env of its own: a relative
# bind source in a file loaded from `oci://` resolves against compose's download cache -
# measured, not assumed. README says so under Deployment.
CURRENCY_DATA_DIR=../backend/data/currencies
EXPENSE_DATA_DIR=$HOME/projects/expense-data/data
