# Pixi environment
.pixi/

# The local PostgreSQL cluster: data directory, postgresql.conf and server.log. Created
# by `pixi run backend-db-init` and thrown away by `pixi run backend-db-reset`. Nothing
# in here is precious - backend/schema.sql can rebuild all of it. Anchored to the one
# directory the db-* tasks address, so a cluster left anywhere else shows up untracked
# instead of being silently hidden.
/backend/.pgdata/

# Real expense data lives in a separate private repository, pointed at by
# EXPENSE_DATA_DIR in backend/.env. Nothing is ever loaded from inside this checkout, so a
# directory reappearing at the old path is an accident, not a source. The samples the
# tests use live under backend/tests/data/expenses/ and are committed.
/backend/data/expenses/

# Python bytecode
__pycache__/
*.py[cod]

# Frontend dependencies, restored with `pixi run frontend-install`.
node_modules/

# Vite build output. Generated by `pixi run frontend-build` and never committed - the
# backend is a REST API and ships nothing from here.
frontend/dist/

# Every .env variant is ignored, and the two committed defaults are named back in. Those
# two hold development values only - an API origin and a loopback database - while any
# other variant is the shape a real credential arrives in, so the default is to keep it
# out. .envrc is committed and matches `.env*`, which is why it is excused too.
.env*
!.envrc
!backend/.env
!frontend/.env

# Test/coverage artifacts
.pytest_cache/
.coverage
coverage.xml

# import-linter's graph cache, written into backend/ by `pixi run backend-lint-imports`.
.import_linter_cache/

# Frontend coverage output (vitest)
coverage/
