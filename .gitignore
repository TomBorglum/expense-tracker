# Pixi environment
.pixi/

# The local PostgreSQL cluster: data directory, postgresql.conf and server.log.
# Created by `pixi run backend-db-init` and thrown away by `pixi run backend-db-reset`.
# Nothing in here is precious - backend/schema.sql can rebuild all of it.
.pgdata/

# Python bytecode
__pycache__/
*.py[cod]

# Frontend dependencies, restored with `pixi run frontend-install`.
node_modules/

# Vite build output. Generated by `pixi run frontend-build` and never committed - the
# backend is a REST API and ships nothing from here.
frontend/dist/

# Local API-origin override; the committed frontend/.env holds the default.
frontend/.env.local

# Test/coverage artifacts
.pytest_cache/
.coverage
coverage.xml

# import-linter's graph cache, written into backend/ by `pixi run backend-lint` - that
# task is ruff followed by lint-imports, and the second half is what writes this.
.import_linter_cache/

# Frontend coverage output (vitest)
coverage/
