# Pixi environment
.pixi/

# Python bytecode
__pycache__/
*.py[cod]

# Frontend dependencies, restored with `pnpm -C frontend install --frozen-lockfile`.
node_modules/

# Vite build output. Generated by `pnpm -C frontend run build` and never committed - the
# backend is a REST API and ships nothing from here.
frontend/dist/

# Local API-origin override; the committed frontend/.env holds the default.
frontend/.env.local

# Test/coverage artifacts
.pytest_cache/
.coverage
coverage.xml

# Frontend coverage output (vitest)
coverage/
