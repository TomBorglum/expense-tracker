// Project-level Zed settings. Committed so the frontend tooling behaves the same
// for everyone; personal preferences belong in your own ~/.config/zed/settings.json.
{
  // REQUIRED ONE-TIME SETUP: install the `html-jinja` extension (Zed: Extensions,
  // search "HTML-Jinja"). Extension installation is a global-only setting, so it
  // cannot be declared here. Pick html-jinja, not the similarly named jinja2
  // extension: our templates are HTML documents with Jinja embedded, and html-jinja
  // layers Jinja onto the HTML grammar, whereas jinja2 uses a standalone Jinja
  // grammar that would degrade the surrounding markup highlighting.
  //
  // EXPECTED WARNING: when the project is opened over a remote (Zed on Windows
  // against a WSL checkout, for example), Zed reports "No language with this name
  // is installed" on the HTML-Jinja entries below. It is a false positive - the
  // settings file is validated by the remote host, and Zed only uploads extensions
  // that provide a language server. html-jinja is grammar-only, so it stays on the
  // client and the remote never learns the name. Highlighting and the status-bar
  // language both work regardless; verify there rather than trusting the squiggle.
  // Do not "fix" it by deleting these entries.

  // Flask templates are Jinja, not plain HTML - without this, {% block %} and
  // {{ ... }} parse as broken markup. The extension only claims .jinja/.jinja2/.j2
  // by default, so .html templates have to be mapped explicitly. Scoped to the
  // templates directory so any other .html file in the repo stays plain HTML.
  "file_types": {
    "HTML-Jinja": ["**/templates/**/*.html"]
  },

  "languages": {
    // The stock CSS server does not know Tailwind v4 at-rules, so it squiggles
    // `@import "tailwindcss"` and `@source` in static/src/input.css and cannot
    // resolve the @source path. The Tailwind server keeps normal CSS IntelliSense
    // and understands both, which also makes the @source path navigable.
    "CSS": {
      "language_servers": [
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "..."
      ]
    },
    // The Tailwind server only attaches to its own default language list, which
    // HTML-Jinja is not on; without this it never starts for the templates.
    "HTML-Jinja": {
      "language_servers": ["tailwindcss-language-server", "..."]
    }
  },

  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        // Having attached above, the server still needs to know how to parse these
        // files. Mapping to html gives class completion in class="..." attributes.
        // Both spellings are listed because the extension declares no language_ids,
        // so the id Zed sends is derived rather than stated - unmatched keys are
        // ignored, so covering both is free.
        "includeLanguages": {
          "html-jinja": "html",
          "HTML-Jinja": "html"
        },
        "experimental": {
          // Tailwind v4 is CSS-first, so the "config" is a stylesheet. Auto-detection
          // usually finds it, but this path is nested deep enough to be worth pinning.
          "configFile": "src/expense_tracker/static/src/input.css",
          "classRegex": ["class=\"([^\"]*)\"", "class='([^']*)'"]
        }
      }
    }
  }
}
