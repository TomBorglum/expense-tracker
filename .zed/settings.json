// Project settings for Zed. Deliberately minimal: it carries only what is specific
// to THIS repo, so it never overrides a preference set in your user settings.
//
// The one thing it must do is stop the editor drifting from what CI enforces. That
// takes two different fixes, because the two stacks drift for different reasons:
//
//   - Frontend: the VERSION drifts. Zed's built-in Tailwind and TypeScript adapters
//     install their own npm "latest" copies under ~/.local/share/zed/; the
//     binary.path overrides below point them at ./frontend/node_modules instead
//     (paths here are relative to the worktree root, not to this file). Run
//     `pixi run web-install` first, or the paths do not exist yet and the language
//     servers will not start.
//   - Backend: the CONFIG drifted, and the fix is not in this file. basedpyright's
//     settings moved to pyrightconfig.json at the worktree root, where the language
//     server finds them unaided. See the note above the "lsp" block.
//
// Before concluding a pin is broken: over a remote/WSL backend Zed's Server Info
// panel shows "Binary: Unknown" for vtsls even when it is working correctly. See
// "Known Zed quirk" in README.md for how to verify properly (use `ps`).
//
// Not set on purpose:
//   format_on_save   - left to your user settings. Formatting is applied by
//                      `pixi run web-format` and gated in CI by web-format-check.
//   formatter        - Zed's default "auto" already picks the pinned prettier.
//   code_actions_on_format.source.fixAll.eslint
//                    - would let eslint rewrite the buffer on save, and Zed runs the
//                      formatter AFTER the code action, so prettier would overwrite
//                      whatever eslint just fixed. Prettier stays the only thing that
//                      formats; apply eslint's fixes with `pixi run web-lint-fix`.
//   language_servers - ["!typescript-language-server", "vtsls", "..."] is already
//                      Zed's default for TSX/TypeScript/JavaScript.
//   load_direnv      - "direct" is already Zed's default; that is what puts pixi's
//                      node on PATH for the #!/usr/bin/env node shims below.
{
  "languages": {
    // Match .prettierrc.json (tabWidth: 2) so hand-typed indentation agrees with
    // what prettier writes. Zed's global default is 4.
    "TSX": { "tab_size": 2 },
    "TypeScript": { "tab_size": 2 },
    "JavaScript": { "tab_size": 2 },
    "CSS": { "tab_size": 2 },
    "HTML": { "tab_size": 2 },
    "JSON": { "tab_size": 2 },
    "JSONC": { "tab_size": 2 }
  },

  // No "basedpyright" entry, on purpose. Its settings live in pyrightconfig.json at
  // the worktree root, which is exactly where the language server looks on its own -
  // so the editor needs no help finding them, here or in any other editor. Pointing
  // at backend/pyproject.toml through basedpyright.analysis.configFilePath was tried
  // twice and does not work: a directory is rejected outright ("Config file ... could
  // not be read"), and a file path is ignored.
  "lsp": {
    "eslint": {
      "settings": {
        // Same anti-drift job as the binary.path pins below, done differently.
        // Zed's eslint support is its own bundled vscode-eslint server, so there
        // is no binary to repoint - what has to be pinned is the eslint MODULE
        // that server require()s at runtime, because that is what supplies the
        // rules, their severities and the version. Left to Zed's own resolution
        // this can land on the worktree root, which has no node_modules now that
        // the frontend owns its dependencies, and the server then falls back to a
        // global eslint or reports nothing at all.
        "nodePath": "frontend/node_modules",
        // Resolve eslint.config.ts and relative ignores from frontend/, where they
        // live. Replaces Zed's default workingDirectory { "mode": "auto" } with
        // something that does not depend on inference.
        "workingDirectories": ["frontend"]
      }
    },
    "tailwindcss-language-server": {
      "binary": {
        // Pinned by frontend/package.json. Without this, Zed installs
        // @tailwindcss/language-server@latest.
        "path": "frontend/node_modules/.bin/tailwindcss-language-server",
        "arguments": ["--stdio"],
        "ignore_system_version": true
      }
    },
    "vtsls": {
      "binary": {
        // Pinned by frontend/package.json. Without this, Zed installs
        // @vtsls/language-server@latest.
        "path": "frontend/node_modules/.bin/vtsls",
        "arguments": ["--stdio"],
        "ignore_system_version": true
      },
      // Spelled out because node_modules/ is no longer at the worktree root: Zed's
      // implicit lookup is for <worktree>/node_modules/typescript/lib, which does
      // not exist here, and vtsls would silently fall back to its own bundled
      // compiler. This keeps the editor on the pinned typescript 6.0.3.
      "settings": {
        "typescript": { "tsdk": "frontend/node_modules/typescript/lib" }
      }
    }
  }
}
