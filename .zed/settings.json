// Project-level Zed settings. Committed so the frontend tooling behaves the same
// for everyone; personal preferences belong in your own ~/.config/zed/settings.json.
//
// Requires `pixi run css-install` (npm ci) to have been run. The Tailwind language
// server resolves `tailwindcss` from node_modules, so the editor uses the exact
// version package.json pins and `pixi run css-build` compiles with - one pin, no
// drift. Without node_modules the server silently falls back to a bundled copy of
// Tailwind: completions still appear but reflect the wrong version, and @source
// paths stop resolving.
{
  "languages": {
    // Two Tailwind servers, doing different jobs - both are needed:
    //
    // tailwindcss-language-server loads the Tailwind project from node_modules and
    // is what resolves `@source` into a document link you can follow to the
    // templates directory. It is listed first so it takes precedence.
    //
    // tailwindcss-intellisense-css replaces the stock CSS server, which does not
    // know the v4 at-rules and squiggles `@import "tailwindcss"` and `@source`. It
    // keeps normal CSS IntelliSense while understanding them - but it never loads a
    // Tailwind project, so on its own the @source path stays unresolvable.
    "CSS": {
      "language_servers": [
        "tailwindcss-language-server",
        "tailwindcss-intellisense-css",
        "!vscode-css-language-server",
        "..."
      ]
    }
  },

  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "experimental": {
          // Tailwind v4 is CSS-first, so the "config" is a stylesheet. Auto-detection
          // usually finds it, but this path is nested deep enough to be worth pinning.
          "configFile": "src/expense_tracker/static/src/input.css"
        }
      }
    }
  }
}

// Deliberately NOT mapping templates/*.html to a Jinja language.
//
// The html-jinja extension highlights {% %} and {{ }} properly, and mapping
// templates to its HTML-Jinja language works for highlighting - but it silently
// kills Tailwind class completion in exactly those files, so the two cannot be had
// together here. Zed routes completion requests from the client, and only registers
// an LSP adapter for a language the client and server both know. Over a remote (Zed
// on Windows against a WSL checkout) the language server runs on the remote, and Zed
// only uploads extensions that provide a language server - html-jinja is grammar-only
// and stays on the client. The remote therefore never learns the HTML-Jinja language,
// no adapter is registered, and Zed never sends textDocument/completion: the server
// receives didOpen/didChange and publishes diagnostics, but is never asked for
// completions. Verified in the LSP RPC log; no includeLanguages value changes it.
//
// Leaving the templates as plain HTML keeps them on the Tailwind server's default
// language list, so class completion works. The cost is that Jinja delimiters get no
// special highlighting. If you want it per-file, switch the buffer language from the
// status bar; if you edit templates locally rather than over a remote, mapping
// file_types to "HTML-Jinja" works fully and is worth reconsidering.
