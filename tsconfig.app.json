{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,

    // Vite does the bundling; tsc is only a type checker here.
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "isolatedModules": true,
    "skipLibCheck": true,
    // Lets App.tsx import greeting.json with a real type.
    "resolveJsonModule": true,

    // No baseUrl: it is deprecated in TypeScript 6, and paths already resolve
    // relative to this file.
    "paths": {
      "@data/*": ["./src/expense_tracker/*"]
    }
  },
  "include": ["frontend/src"]
}
