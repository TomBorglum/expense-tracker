use pixi python
use sonarqube_mcp

# PGHOST, PGPORT, PGUSER and PGDATABASE. Nothing else loads them: the app reads the
# environment and opens no file of its own, poe declares no `envfile`, and in CI
# setup-direnv forwards whatever these two lines produce. .env.local second, because a
# later dotenv wins.
dotenv_if_exists backend/.env
dotenv_if_exists backend/.env.local
