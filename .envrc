use pixi python
use sonarqube_mcp

# PGHOST, PGPORT, PGUSER and PGDATABASE, for anything launched from a shell rather than
# through poe. The app reads the environment and opens no file of its own, so these two
# lines and poe's `envfile` are the whole of what puts those four names there. .env.local
# second, because a later dotenv wins.
dotenv_if_exists backend/.env
dotenv_if_exists backend/.env.local
