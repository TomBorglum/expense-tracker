use pixi 0.81.0 python

# PGHOST, PGPORT, PGUSER, PGDATABASE, UVICORN_PORT, EXPENSE_DATA_DIR and
# CURRENCY_DATA_DIR. Nothing else loads them: the app reads the environment and opens no
# file of its own, poe declares no `envfile`, and in CI setup-direnv forwards whatever
# this line produces.
dotenv_if_exists backend/.env

# IMAGE_PREFIX, IMAGE_TAG and API_BASE_URL, which only the compose stack reads.
# Loaded here rather than left to compose's own auto-loading of the .env beside a compose
# file, so that every .env in this repository reaches a shell by one mechanism. Compose
# auto-loads it as well, from the same file, so the two cannot disagree.
dotenv_if_exists stack/.env

# Per-machine overrides, layered on top of the defaults above so a value that names a
# place rather than the project - EXPENSE_DATA_DIR - can be redirected without editing a
# tracked file. Absent on most machines, which is why this is `_if_exists`. Matches the
# `.env*` rule in .gitignore, and is not among the two names negated back in there.
dotenv_if_exists backend/.env.local
